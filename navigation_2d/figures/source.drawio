        <mxCell id="VDm2wrdBnlTMptT0TTgu-4" edge="1" parent="WUU0yxVFWuJvOViH3bZZ-1" source="WUU0yxVFWuJvOViH3bZZ-33" style="endArrow=none;html=1;rounded=0;fillColor=#f5f5f5;strokeColor=#666666;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="110" y="217.5" as="sourcePoint" />
            <mxPoint x="110" y="160" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="VDm2wrdBnlTMptT0TTgu-5" connectable="0" parent="VDm2wrdBnlTMptT0TTgu-4" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" value="\( S_{eff} \)" vertex="1">
          <mxGeometry relative="1" x="-0.022" as="geometry">
            <mxPoint y="-10" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="VDm2wrdBnlTMptT0TTgu-6" parent="WUU0yxVFWuJvOViH3bZZ-1" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" value="&lt;div&gt;(1)&lt;/div&gt;Entre t et t+dt, il traverse dn = u * S_eff * N * dt particules de fluide&lt;div&gt;La masse d&#39;eau entrée en contact est donc m =&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;u * S_eff * rho * dt = u * S* cos(beta) * rho * dt&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;qtt de mvt integralement transmise (faux mais osef) p = dm * u =&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;u^2 * S* cos(beta) * rho * dt&lt;/span&gt;&lt;/div&gt;&lt;div&gt;force résultante F_p = dp/dt = rho*u^2*S*cos(beta)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;(2)&lt;/div&gt;&lt;div&gt;avant impact, particule de fluide: p1 = m * u&lt;/div&gt;&lt;div&gt;apres impact, particule de fluide: p2 = 0&lt;/div&gt;&lt;div&gt;quantité de mvt transmise à la gouverne dp = m * u&lt;/div&gt;&lt;div&gt;dF_p * dt = m&amp;nbsp;* u&lt;/div&gt;&lt;div&gt;force de pression exercée par une particule&lt;/div&gt;&lt;div&gt;Nombres de particules entre t et t+dt: n =&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;u * S_eff * N * dt&lt;/span&gt;&lt;/div&gt;&lt;div&gt;F_p = n*dF_p (qtt de mvt uniformément répartie entre les particules)&lt;/div&gt;&lt;div&gt;F_p = rho * u^2 * S_eff&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;dp2 = 0, p gouverne // dp1, donc F_g // u. Donc dans la modélisation sans derapage,&lt;/div&gt;&lt;div&gt;&amp;nbsp;F_p&amp;nbsp; // u // cap du bateau, donc juste de la trainée, pas de composante transversale&amp;nbsp;&lt;/div&gt;&lt;div&gt;pour faire tourner. Dans les faits, dp2 != 0, la particule n&#39;est pas arrêtée après impact, elle est&lt;/div&gt;&lt;div&gt;réfléchie avec le meme angle, et donc vec(p_gouverne) = vec(dp1) - vec(dp2). on a une composante transversale.&lt;/div&gt;" vertex="1">
          <mxGeometry height="320" width="630" x="250" y="80" as="geometry" />
        </mxCell>
